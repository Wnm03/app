    "audit:persistence": "node scripts/persistence-integrity-gate.js",
    "audit:pwa": "node scripts/pwa-recovery-integrity-gate.js",
    "audit:features": "node scripts/feature-regression-gate.js",
    "release:firewall": "node scripts/release-firewall.js",
    "build:patch": "node scripts/build-with-patch-manifest.js",
    "audit:test-hygiene": "node scripts/audit-brittle-source-tests.js",
    "build:atomic": "node scripts/build-atomic.js",
    "audit:patch-integrity": "node scripts/verify-patch-integrity.js",
    "audit:duplicates": "node scripts/audit-duplicate-dead-code.js",
    "audit:runtime-io": "node scripts/audit-runtime-io.js",
    "audit:event-listeners": "node scripts/audit-event-listeners.js",
    "audit:scalability": "node scripts/verify-carnotes-scalability.js",
    "audit:patch-contamination": "node scripts/verify-patch-contamination.js",
    "verify:reproducible-build": "node scripts/verify-reproducible-build.js",
    "audit:app-wide": "node scripts/s1860-app-wide-hardening-gate.js",
    "audit:performance-budget": "node scripts/performance-budget.js",
    "release:ui-gate": "node scripts/release-ui-gate.js",
    "release:final-gate": "node scripts/release-final-gate.js",
    "audit:production-readiness": "node scripts/audit-production-readiness.js",
    "test:full:fast": "node scripts/run-full-test.js",
    "audit:backup-integrity": "node --test tests/s1901-backup-integrity-and-error-safety.test.js",
    "audit:system-integrity": "node scripts/system-integrity-audit.js",
    "audit:release-closure": "node scripts/release-gate-closure-audit.js",
    "audit:carnotes-advanced": "node scripts/service-advanced-integrity-gate.js",
    "audit:sot-map": "node scripts/s2153-sot-architecture-map-audit.js",
    "audit:sot-consolidation": "node scripts/s2154-s2159-sot-consolidation-audit.js",
    "audit:sot-drift": "node scripts/s2160-sot-drift-orphan-gate.js",
    "audit:sot-reconciliation": "node scripts/s2161-existing-data-sot-reconciliation.js",
    "audit:sot-migration": "node scripts/s2162-sot-migration-gate.js",
    "audit:sot-legacy-map": "node scripts/s2163-legacy-mapping-gate.js",
    "audit:sot-reviewed-migration": "node scripts/s2164-reviewed-mapping-migration-gate.js",
    "audit:sot-post-migration": "node scripts/s2165-post-migration-reconciliation-gate.js",
    "audit:sot-runtime-projection": "node scripts/s2166-runtime-projection-sync-gate.js",
    "audit:sot-production-wiring": "node scripts/s2167-production-runtime-wiring-gate.js",
    "audit:bundle-b-residency": "node scripts/s2252-bundle-b-residency-audit.js",
    "build:dev": "node scripts/build.js",
    "audit:release-contract": "node scripts/release-contract-audit.js",
    "audit:deploy-data-continuity": "node scripts/deploy-data-continuity-gate.js"
