{
  "name": "keluarga-w",
  "version": "0.85.10",
  "description": "Aplikasi manajemen keuangan, zakat, bisnis, dan kendaraan keluarga (Keluarga W) — PWA multi-file, dibangun jadi app-bundle-a.min.js / app-bundle-b.min.js lewat build.js.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.js",
    "build:safe": "node scripts/build-with-tests.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "verify-bundle": "node scripts/verify-bundle-freshness.js",
    "verify-window-expose": "node scripts/verify-window-expose.js",
    "release-check": "node scripts/verify-release-ready.js",
    "check": "npm run lint && npm run verify-window-expose && npm test && npm run build",
    "release": "bash scripts/release.sh",
    "service-sot-gate": "node scripts/service-sot-integrity-gate.js",
    "audit:carnotes": "node scripts/verify-carnotes-integrity.js",
    "audit:source-size": "node scripts/verify-source-size.js --strict",
    "test:critical": "node --test tests/carnotes-permanent-integrity-gate.test.js tests/fresh-install-cache-integrity.test.js tests/carnotes-theme-pro-rollback.test.js tests/carnotes-navigation-servis-regression-1749.test.js",
    "test:full": "node scripts/run-full-test.js",
    "audit:carnotes-performance": "node scripts/verify-carnotes-performance.js",
    "build:release": "node scripts/build.js --require-minify",
    "release:preflight": "node scripts/build.js --require-minify && node scripts/verify-release-ready.js",
    "apply-delete-manifest": "node scripts/apply-delete-manifest.js",
    "audit:sot": "node scripts/sot-integrity-gate.js",
    "audit:architecture": "node scripts/architecture-integrity-gate.js",
    "audit:persistence": "node scripts/persistence-integrity-gate.js",
    "audit:pwa": "node scripts/pwa-recovery-integrity-gate.js",
    "audit:features": "node scripts/feature-regression-gate.js",
    "release:firewall": "node scripts/release-firewall.js",
    "build:patch": "node scripts/build-with-patch-manifest.js",
    "audit:test-hygiene": "node scripts/audit-brittle-source-tests.js",
    "build:atomic": "node scripts/build-atomic.js",
    "audit:patch-integrity": "node scripts/verify-patch-integrity.js",
    "audit:duplicates": "node scripts/audit-duplicate-dead-code.js",
    "audit:runtime-io": "node scripts/audit-runtime-io.js",
    "audit:event-listeners": "node scripts/audit-event-listeners.js",
    "audit:scalability": "node scripts/verify-carnotes-scalability.js",
    "audit:patch-contamination": "node scripts/verify-patch-contamination.js",
    "verify:reproducible-build": "node scripts/verify-reproducible-build.js"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
