    "test:full": "node scripts/run-full-test.js",
    "audit:carnotes-performance": "node scripts/verify-carnotes-performance.js",
    "build:release": "node scripts/build.js --require-minify",
    "release:preflight": "node scripts/build.js --require-minify && node scripts/verify-release-ready.js",
    "apply-delete-manifest": "node scripts/apply-delete-manifest.js",
    "audit:sot": "node scripts/sot-integrity-gate.js",
