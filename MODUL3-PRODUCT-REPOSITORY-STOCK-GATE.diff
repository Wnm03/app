+test('integrasi: cobek-tx-cart.js recordShopSale() memakai ProductRepository.mutateStockDelta() sebagai gate saat produk dimuat', () => {
+  const D = {
+    products: [{ id: 'prod1', name: 'Cobek 20cm', stock: 10, hargaBeli: 20000, hargaJual: 40000 }],
