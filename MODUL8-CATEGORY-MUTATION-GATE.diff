+
+test('integrasi: cobek-etalase.js Etalase.addKategoriManual() cabang edit — lewat CategoryStore.mutateRename()', () => {
+  const D = { cobekKategori: [{ id: 'ck_1', name: 'Kecil' }], products: [] };
